#!name=中国联通凭据抓取
#!desc=打开联通 App 后在本机保存凭据，通过 BoxJS 复制 chinaUnicomCookie 到青龙。需启用 MITM 并信任证书，不自动同步青龙。
#!homepage=https://github.com/shulkx/MyCookieCenter/tree/surge/scripts/tools/unicom

[Script]
UnicomCookie = type=http-request, pattern=^https://m\.client\.10010\.com/mobileService/onLine\.htm(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/shulkx/MyCookieCenter/surge/scripts/tools/unicom/unicom.cookie.js?v=77e85d13, timeout=10

[MITM]
hostname = %APPEND% m.client.10010.com